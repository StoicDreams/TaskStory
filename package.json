{
  "name": "taskstory",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "vitest run && playwright test --project=live-cdn",
    "test:unit": "vitest run",
    "test:browser": "playwright test --project=live-cdn",
    "test:full": "vitest run --mode full && playwright test --project=live-cdn",
    "test:local-cdn": "vitest run --mode local-cdn && playwright test --project=local-cdn",
    "test:ui": "playwright test --project=live-cdn --ui",
    "test:report": "playwright show-report",
    "screenshots": "playwright test --config playwright.screenshots.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sinonjs/fake-timers": "^15.5.0",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "vitest": "^5.1.1"
  }
}
